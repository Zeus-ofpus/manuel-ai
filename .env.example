# Copy to .env (local) or set in Vercel > Project > Settings > Environment Variables
GEMINI_API_KEY=        # Google AI Studio key (chat, images, voice)
GROQ_API_KEY=          # Groq key (fast fallback chat, speech-to-text, TTS)
TAVILY_API_KEY=        # Tavily key (live web search)
SUPABASE_URL=          # optional: accounts + memory
SUPABASE_ANON_KEY=     # optional: public anon key
SUPABASE_SERVICE_ROLE_KEY=  # optional: server-only, never expose
THINKING_LEVEL=        # optional Gemini thinking level
